@inproceedings{10.1145/243199.243203,
author = {Bell, Timothy A. H. and Moffat, Alistair},
title = {The design of a high performance information filtering system},
year = {1996},
isbn = {0897917928},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/243199.243203},
doi = {10.1145/243199.243203},
abstract = {A high performance information filtering system has three main requirements: it must be effective in supplying users with useful information, it must do so in a timely fashion, and it must be able to handle a large throughput of information and a large number of user profiles efficiently. These three requirements pose a difficult problem, and to our knowledge no existing system is capable of meeting all three. In this paper we describe a system which combines a number of techniques from other information retrieval and filtering systems, and is capable of providing high performance on a typical workstation platform. We provide estimates of computing resource usage, and show that our system is also scalable.},
booktitle = {Proceedings of the 19th Annual International ACM SIGIR Conference on Research and Development in Information Retrieval},
pages = {12–20},
numpages = {9},
location = {Zurich, Switzerland},
series = {SIGIR '96}
}


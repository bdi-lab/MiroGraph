@inproceedings{10.1145/347090.347176,
author = {Beeferman, Doug and Berger, Adam},
title = {Agglomerative clustering of a search engine query log},
abstract = {This paper introduces a technique for mining user clickthrough data from an Internet search engine to discover clusters of similar queries and URLs by modeling the data as a bipartite graph between queries and URLs and applying agglomerative clustering in a content-ignorant manner that relies solely on co-occurrence patterns, and demonstrates how the resulting clusters can be used to assist web search and evaluates their effectiveness using the Lycos search engine.},

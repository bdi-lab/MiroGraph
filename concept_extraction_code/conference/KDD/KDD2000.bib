booktitle = {Proceedings of the Sixth ACM SIGKDD International Conference on Knowledge Discovery and Data Mining},
pages = {365–369},
numpages = {5},
keywords = {clustering, evolutionary search, feature selection},
location = {Boston, Massachusetts, USA},
series = {KDD '00}
}

@inproceedings{10.1145/347090.347170,
author = {Inselberg, Alfred and Avidan, Tova},
title = {Classification and visualization for high-dimensional data},
abstract = {A geometrically motivated classifier is presented and applied, with both training and testing stages, to three real datasets, and achieves the lowest error compared to 23 other classifiers; the algorithm is based on parallel coordinates, has worst-case computational complexity O(N^2 |P|^2) in the number of variables N and dataset size |P|, provides comprehensible and explicit rules, performs dimensionality selection by identifying the minimal set of original variables required to state the rule rather than transformed variables as in PCA, and orders these variables to optimize the clarity of separation between the designated set and its complement.},
